# ===== 阿里云百炼（DashScope）=====
# 兼容 OpenAI 协议；在 https://bailian.console.aliyun.com/ 创建 API Key
ALI_API_KEY=sk-your-dashscope-api-key

# ===== Java 服务数据库（Spring Boot, 8082）=====
# application.yml 中已内置本地默认值，按需覆盖即可
DB_URL=jdbc:mysql://localhost:3306/project06?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456

# ===== 说明 =====
# 钉钉机器人 access_token 不放在 .env 中，导入 N8N 工作流后
# 在「A · 钉钉高危告警推送」的 HTTP Request 节点里替换
# access_token=YOUR_DINGTALK_ACCESS_TOKEN
